{{- $use_secrets := promptBoolOnce . "use_secrets" "Use secrets from Bitwarden? (true/false)" -}}
{{- $personal_computer := promptBoolOnce . "personal_computer" "Is this a personal computer for daily driving? (true/false)" -}}
{{- $dev_computer := promptBoolOnce . "dev_computer" "Do you do development on this computer? (true/false)" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}

[data]
    email             = {{ $email | quote }}
    github_user       = "elson"
    dev_computer      = {{ $dev_computer }}
    personal_computer = {{ $personal_computer }}
    is_ci_workflow    = false # Set true only in CI test
    use_secrets       = {{ $use_secrets }}
    xdgCacheDir       = "{{ .chezmoi.homeDir }}/.cache"
    xdgConfigDir      = "{{ .chezmoi.homeDir }}/.config"
    xdgDataDir        = "{{ .chezmoi.homeDir }}/.local/share"
    xdgStateDir       = "{{ .chezmoi.homeDir }}/.local/state"
    xdgScriptsDir     = "{{ .chezmoi.homeDir }}/.local/scripts"

# Installs Homebrew / apt basics / rbw before the source state is read, and
# unlocks the rbw agent — early enough that rbwFields templates render on the
# first apply, from one password prompt rather than one per secret.
# See .install-prerequisites.sh; it exits fast when everything is already present.
[hooks.read-source-state.pre]
    command = "{{ .chezmoi.sourceDir }}/.install-prerequisites.sh"

{{ if eq .chezmoi.os "linux" -}}
# rbwFields shells out to this. An absolute path, because chezmoi finds it via
# its own PATH — and during bootstrap that PATH has no ~/.local/bin: the
# get.chezmoi.io one-liner runs chezmoi by absolute path, before any shell
# config exists. Exporting PATH inside the prerequisites hook cannot help, since
# the hook is a child of chezmoi, not its parent.
[rbw]
    command = "{{ .chezmoi.homeDir }}/.local/bin/rbw"

{{ end -}}
[diff]
    {{ if lookPath "delta" -}}command = "delta"
    {{ end -}}
    exclude = ["scripts"]

{{ if lookPath "code" -}}
[edit]
    args    = ["-r", "--wait"]
    command = "code"

[merge]
    command = "bash"
    args = [
        "-c",
        "cp '{{ "{{" }} .Target {{ "}}" }}' '{{ "{{" }} .Target {{ "}}" }}.base' && code --new-window --wait --merge '{{ "{{" }} .Destination {{ "}}" }}' '{{ "{{" }} .Target {{ "}}" }}' '{{ "{{" }} .Target {{ "}}" }}.base' '{{ "{{" }} .Source {{ "}}" }}'",
    ]
{{ end -}}