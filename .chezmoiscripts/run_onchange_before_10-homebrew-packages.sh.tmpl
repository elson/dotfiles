{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

{{ template "shared_script_utils.bash" . }}
{{ template "homebrew_env.bash" . }}

# Fail rather than carry on: this script always exits 0 otherwise, chezmoi would
# record it as run with every install failed, and an unchanged run_onchange_
# script never runs again — the casks and formulae would stay missing for good.
if ! command -v brew &>/dev/null; then
    echo "❌  Homebrew not found; re-run chezmoi apply once it is installed" >&2
    exit 1
fi

export HOMEBREW_NO_INSTALL_UPGRADE=TRUE
export HOMEBREW_CASK_OPTS="--appdir=/Applications"
export HOMEBREW_NO_INSTALL_CLEANUP=1

formulae=(
    {{ range $package := .packages.homebrew.common.formulae }}
    "{{ $package }}"
    {{ end }}

    {{ if .dev_computer }}
    {{ range $package := .packages.homebrew.dev_computer.formulae }}
    "{{ $package }}"
    {{ end }}
    {{ end }}

    {{ if .personal_computer }}
    {{ range $package := .packages.homebrew.personal_computer.formulae }}
    "{{ $package }}"
    {{ end }}
    {{ end }}

    {{ if dig "work_computer" false . }}
    {{ range $package := .packages.homebrew.work_computer.formulae }}
    "{{ $package }}"
    {{ end }}
    {{ end }}
)

casks=(
    {{ range $package := .packages.homebrew.common.casks }}
    "{{ $package }}"
    {{ end }}

    {{ if .dev_computer }}
    {{ range $package := .packages.homebrew.dev_computer.casks }}
    "{{ $package }}"
    {{ end }}
    {{ end }}

    {{ if .personal_computer }}
    {{ range $package := .packages.homebrew.personal_computer.casks }}
    "{{ $package }}"
    {{ end }}
    {{ end }}

    {{ if dig "work_computer" false . }}
    {{ range $package := .packages.homebrew.work_computer.casks }}
    "{{ $package }}"
    {{ end }}
    {{ end }}
)

# Homebrew 6 refuses to load formulae/casks from a third-party tap until the tap
# is trusted, and trusting it interactively would break an unattended apply. A
# vendor/tap/name entry in packages.toml is already the decision to trust that
# tap, so derive the tap list from the package names rather than duplicating it.
trusted_taps=()
for package in "${formulae[@]}" "${casks[@]}"; do
    [[ ${package} == */*/* ]] || continue
    tap="${package%/*}"

    if ! _inArray_ -i "${tap}" "${trusted_taps[@]}"; then
        trusted_taps+=("${tap}")
        brew trust --quiet --tap "${tap}"
    fi
done

currently_installed_formulae=($(brew list --formula -1))
currently_installed_casks=($(brew list --cask -1))

echo "Install Homebrew packages"

brew update

BREW_DIR="$(brew --prefix)/bin/"

# Collected rather than fatal: one unavailable cask should not stop the rest of
# the apply. Reported at the end so failures do not vanish up the scrollback.
failed=()

for formula in ${formulae[@]}; do
    # brew list reports the bare name, so a tapped formula must be compared on
    # its basename: vendor/tap/foo -> foo
    formula_name="${formula##*/}"

    if ! _inArray_ -i "${formula_name}" "${currently_installed_formulae[@]}"; then
        if [[ ! -e "${BREW_DIR}/${formula_name}" ]]; then
            brew install -q --formula ${formula} || failed+=("formula:${formula}")
        fi

        # https://github.com/microsoft/Git-Credential-Manager-for-Mac-and-Linux/blob/master/Install.md
        if [[ ${formula_name} == "git-credential-manager" ]]; then
            git-credential-manager install
        fi

    fi
done

{{ if not .is_ci_workflow }}
missing_casks=()
for cask in ${casks[@]}; do
    _inArray_ -i "${cask}" "${currently_installed_casks[@]}" || missing_casks+=("${cask}")
done

# Casks that ship a .pkg, or write outside /Applications, run sudo themselves.
# macOS caches sudo for only 5 minutes, and a run of cask downloads outlasts
# that, so each one asked again. Prompt once up front, then keep the timestamp
# fresh until this script exits.
if [[ ${#missing_casks[@]} -gt 0 ]] && sudo -v; then
    while kill -0 "$$" 2>/dev/null; do
        sudo -n true 2>/dev/null
        sleep 60
    done &
    sudo_keepalive=$!
    trap 'kill "${sudo_keepalive}" 2>/dev/null' EXIT
fi

for cask in ${casks[@]}; do
    if ! _inArray_ -i "${cask}" "${currently_installed_casks[@]}"; then
        # --adopt takes over an app that was installed by hand instead of
        # failing on it. Safe for the self-updating casks that make up almost
        # all of this list: brew skips the version comparison when a cask
        # declares auto_updates, and never upgrades it afterwards without
        # --greedy. A cask without auto_updates whose on-disk copy has drifted
        # still fails loudly rather than being overwritten.
        brew install -q --cask --adopt ${cask} || failed+=("cask:${cask}")
    fi

done
{{ end }}

if [[ ${#failed[@]} -gt 0 ]]; then
    echo "⚠️  Homebrew packages installed, with ${#failed[@]} failure(s):"
    printf '      %s\n' "${failed[@]}"
else
    echo "Homebrew packages installed"
fi

{{- end }}