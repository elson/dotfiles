{{- $id := dig "id" "" .chezmoi.osRelease -}}
{{- $idLike := dig "idLike" "" .chezmoi.osRelease -}}
{{- if and (eq .chezmoi.os "linux") (or (eq $id "debian") (contains "debian" $idLike)) -}}
#!/usr/bin/env bash

# Tools with no apt package at all, installed from a pinned upstream release
# into ~/.local/bin (already on PATH via .config/shell/exports.sh). No sudo, so
# a failure here cannot wedge the box or block the apt scripts.
#
# Versions come from .chezmoidata/packages.yaml — bumping one changes this
# script's rendered content, which is what makes chezmoi re-run it.
#   gron   {{ .versions.gron }}
#   herdr  {{ .versions.herdr }}
#   tflint {{ .versions.tflint }}

set -eo pipefail

{{ template "shared_script_utils.bash" . }}

BIN_DIR="{{ .chezmoi.homeDir }}/.local/bin"
mkdir -p "${BIN_DIR}"

arch="$(_debArch_)"

for tool in curl tar unzip; do
    if ! command -v "${tool}" &>/dev/null; then
        echo "${tool} not found — install it (apt) and re-apply" >&2
        exit 1
    fi
done

_stampMatches_() {
    # $1 tool, $2 wanted version — true when that exact version is already in place
    [[ -x ${BIN_DIR}/${1} ]] && [[ $(cat "$(_versionStamp_ "${1}")" 2>/dev/null) == "${2}" ]]
}

_recordVersion_() {
    local stamp
    stamp="$(_versionStamp_ "${1}")"
    mkdir -p "$(dirname "${stamp}")"
    echo "${2}" >"${stamp}"
}

install_gron() {
    local version="{{ .versions.gron }}"
    if _stampMatches_ gron "${version}"; then
        echo "✅  gron ${version} already installed"
        return 0
    fi

    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' RETURN

    echo "⬇️   Installing gron ${version} (${arch})"
    curl -fsSL --max-time 120 -o "${tmp}/gron.tgz" \
        "https://github.com/tomnomnom/gron/releases/download/v${version}/gron-linux-${arch}-${version}.tgz"
    tar -xzf "${tmp}/gron.tgz" -C "${tmp}"
    install -m 0755 "${tmp}/gron" "${BIN_DIR}/gron"
    _recordVersion_ gron "${version}"
}

install_tflint() {
    local version="{{ .versions.tflint }}"
    if _stampMatches_ tflint "${version}"; then
        echo "✅  tflint ${version} already installed"
        return 0
    fi

    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' RETURN

    echo "⬇️   Installing tflint ${version} (${arch})"
    curl -fsSL --max-time 120 -o "${tmp}/tflint.zip" \
        "https://github.com/terraform-linters/tflint/releases/download/v${version}/tflint_linux_${arch}.zip"
    unzip -qo "${tmp}/tflint.zip" -d "${tmp}"
    install -m 0755 "${tmp}/tflint" "${BIN_DIR}/tflint"
    _recordVersion_ tflint "${version}"
}

install_herdr() {
    local version="{{ .versions.herdr }}"
    if _stampMatches_ herdr "${version}"; then
        echo "✅  herdr ${version} already installed"
        return 0
    fi

    # herdr names its assets by uname -m, not by the Debian architecture
    local herdr_arch
    case "${arch}" in
        amd64) herdr_arch="x86_64" ;;
        arm64) herdr_arch="aarch64" ;;
        *)
            echo "No herdr release for ${arch}; skipping" >&2
            return 0
            ;;
    esac

    # A bare static binary, not an archive — download straight into place
    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' RETURN

    echo "⬇️   Installing herdr ${version} (${herdr_arch})"
    curl -fsSL --max-time 120 -o "${tmp}/herdr" \
        "https://github.com/herdrdev/herdr/releases/download/v${version}/herdr-linux-${herdr_arch}"
    install -m 0755 "${tmp}/herdr" "${BIN_DIR}/herdr"
    _recordVersion_ herdr "${version}"
}

install_gron

{{ if .dev_computer }}
install_herdr
install_tflint
{{ end }}

{{- end }}
