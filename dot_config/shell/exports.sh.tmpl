#!/usr/bin/env sh

### Path
export PATH={{ .chezmoi.homeDir }}/.local/bin:$PATH

### Language / Fonts
# LANG and LC_ALL are set at the top of .zshrc instead — they have to be in
# place before antigen draws a prompt, which happens long before this file is
# sourced, and the value has to be checked against what the box has generated.

### editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='vim'
fi

### SSH agent — rbw-agent has one built in, holding the keys from the vault
# Skipped inside an SSH session: there SSH_AUTH_SOCK is the agent forwarded from the
# client (ForwardAgent yes for every host in ~/.ssh/config), and this file is applied on
# the Debian boxes too — overriding it would swap the keys the session arrived with for
# whatever the remote vault holds.
if [ -z "${SSH_CONNECTION:-}" ] && command -v rbw-agent >/dev/null 2>&1; then
    # Mirrors runtime_dir() in rbw's src/dirs.rs: XDG_RUNTIME_DIR when the platform
    # provides one, otherwise {temp_dir}/{profile}-{uid} — which is what macOS always
    # uses, since it has no runtime dir. Same code path on both OSes.
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        _rbw_runtime_dir="${XDG_RUNTIME_DIR}/rbw"
    else
        _rbw_runtime_dir="${TMPDIR:-/tmp}/rbw-$(id -u)"
    fi
    # Unconditional, unlike the old `[ -S ... ] &&` guard: rbw-agent starts lazily on the
    # first rbw command, so a shell opened before that kept whatever agent the session
    # had — on macOS a launchd one holding no identities — and every ssh fell through to
    # a password prompt. The path is fixed per user, so exporting it before the agent
    # exists costs nothing and starts working the moment the agent does.
    export SSH_AUTH_SOCK="${_rbw_runtime_dir}/ssh-agent-socket"
    # rbw-agent daemonizes itself, so this returns immediately; backgrounding it would
    # print a job number into an interactive shell. `|| :` keeps a failed start from
    # leaving a non-zero $? for the prompt.
    [ -S "${SSH_AUTH_SOCK}" ] || rbw-agent >/dev/null 2>&1 || :
    unset _rbw_runtime_dir
fi

### AWS CLI
export AWS_CONFIG_FILE={{ .xdgConfigDir }}/aws/config
export AWS_SHARED_CREDENTIALS_FILE={{ .xdgConfigDir }}/aws/credentials
export AWS_PROFILE=runpod