#!/usr/bin/env sh

### Path
export PATH={{ .chezmoi.homeDir }}/.local/bin:$PATH

### Language / Fonts
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

### editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='vim'
fi

### Bitwarden SSH Agent
{{ if eq .chezmoi.os "darwin" -}}
export SSH_AUTH_SOCK={{ .chezmoi.homeDir }}/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
{{- else -}}
# The Bitwarden desktop app is macOS-only here; fall back to whatever agent the
# session already provides (gnome-keyring, ssh-agent, forwarded agent, ...).
{{- end }}

### AWS CLI
export AWS_CONFIG_FILE={{ .xdgConfigDir }}/aws/config
export AWS_SHARED_CREDENTIALS_FILE={{ .xdgConfigDir }}/aws/credentials
export AWS_PROFILE=runpod