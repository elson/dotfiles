#!/bin/sh
# gh's own helper only serves the active account, so a dash0hq repo would
# authenticate as whichever account was last switched to. Pin that org to the
# work account and leave every other repo on the active one.
[ "$1" = get ] || exit 0
input=$(cat)
path=$(printf '%s\n' "$input" | sed -n 's/^path=//p')
case "$path" in
  dash0hq/*)
    token=$(gh auth token --hostname github.com --user elson-dash0) || exit 0
    printf 'username=elson-dash0\npassword=%s\n' "$token"
    ;;
  *)
    printf '%s\n' "$input" | gh auth git-credential get
    ;;
esac
